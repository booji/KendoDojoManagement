# Test environment — safe to commit, do NOT use in production

# PostgreSQL (Docker Compose)
POSTGRES_USER=kendo_test
POSTGRES_PASSWORD=kendo_test_password
POSTGRES_DB=kendo_test

# Application
# development | production. Dev/test deliberately stay on development so the
# production-only WEBAUTHN_* localhost-default checks do not fire here.
APP_ENV=development
# The restricted app user (ADR-0007), provisioned by the migration step. The
# e2e server connects as it; pytest itself keeps the superuser below.
DATABASE_URL=postgresql+asyncpg://kendo_app:kendo_app_password@db:5432/kendo_test
# The superuser (POSTGRES_USER above): migrations, scratch databases, fixtures.
MIGRATION_DATABASE_URL=postgresql+asyncpg://kendo_test:kendo_test_password@db:5432/kendo_test
JWT_SECRET=test-jwt-secret-not-for-production-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
# Gates the first-admin claim (ADR-0003). Required at startup; nothing here
# is protecting anything, so the value is deliberately not a secret.
SETUP_TOKEN=test-not-a-secret
JWT_EXPIRE_MINUTES=60
COOKIE_SECURE=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_CHALLENGE_TTL_SECONDS=60
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_IP=1000/minute
ALLOW_TEST_AUTH=true
STATIC_DIR=/tmp/static/logos
# The login-complete and recovery-redeem floors (#594) hold every such call,
# for seconds in redeem's case, which the suite would pay call by call. The
# floors' own tests set the value they measure against.
RECOVERY_REDEEM_MIN_DURATION_MS=1
LOGIN_COMPLETE_MIN_DURATION_MS=1
