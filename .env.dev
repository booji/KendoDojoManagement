# Development environment — safe to commit, do NOT use in production

# PostgreSQL (Docker Compose)
POSTGRES_USER=kendo_dev
POSTGRES_PASSWORD=kendo_dev_password
POSTGRES_DB=kendo_dev
# Host port the dev database is published on. Deliberately not 5432: that is
# owned by any system PostgreSQL or other project's stack on the machine (#275).
# Change it to run two checkouts of this repo side by side — and change the port
# in DATABASE_URL below to match.
POSTGRES_PORT=5433

# Application
# development | production. Dev/test deliberately stay on development so the
# production-only WEBAUTHN_* localhost-default checks do not fire here.
APP_ENV=development
# Points at the published host port, so this works both inside the host-networked
# backend container and for host-side tooling (alembic, psql). 127.0.0.1 rather
# than "localhost": the port is bound to the IPv4 loopback only, and "localhost"
# can resolve to ::1 first.
DATABASE_URL=postgresql+asyncpg://kendo_dev:kendo_dev_password@127.0.0.1:5433/kendo_dev
JWT_SECRET=dev-jwt-secret-not-for-production-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Gates the first-admin claim (ADR-0003). Required at startup; nothing here
# is protecting anything, so the value is deliberately not a secret.
SETUP_TOKEN=dev-not-a-secret
JWT_EXPIRE_MINUTES=480
# Production values, deliberately. The dev stack serves
# https://dojo.localhost:8443 through Traefik, so Secure cookies, the passkey
# origin/RP ID and the X-Forwarded-For path are exercised every working day
# instead of for the first time at cutover — see
# docs/adr/0002-traefik-in-the-dev-stack.md.
COOKIE_SECURE=true
# The RP ID is the bare host; the port belongs to the origin only.
WEBAUTHN_RP_ID=dojo.localhost
WEBAUTHN_ORIGIN=https://dojo.localhost:8443
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
CORS_ORIGINS=https://dojo.localhost:8443
# Safe here because Traefik overwrites X-Forwarded-For with the address it
# observed. The direct :8000 escape hatch is still published, so a request sent
# straight there can claim any IP — do not use it to test rate limiting.
TRUST_PROXY_XFF=true
STATIC_DIR=/tmp/static/logos
