# Traefik edge proxy: terminates TLS, redirects 80->443, routes to kendo-app.
# The ONLY container that publishes host ports. Edge network only (never touches
# the db).
#
# Provider-neutral: ACME DNS-01 credentials are NOT here. They differ per DNS
# provider, and only a DNS-01 deployment has any, so they arrive as a drop-in at
# kendo-traefik.container.d/10-dns-01.conf — which `setup.sh --quadlet` writes
# and which survives re-copying this unit on upgrade (#412).
#
# Binding 80/443 as a rootless user requires:
#   net.ipv4.ip_unprivileged_port_start=80   (see deploy/sysctl — Q9 option 1)
[Unit]
Description=Kendo Traefik
Requires=kendo-app.service
After=kendo-app.service

[Container]
ContainerName=kendo-traefik
Image=docker.io/library/traefik:v3.3
Network=kendo-edge.network
PublishPort=80:80
PublishPort=443:443
Volume=kendo-traefik-acme.volume:/acme
Volume=%h/kendo/traefik/traefik.yml:/etc/traefik/traefik.yml:ro,Z
Volume=%h/kendo/traefik/dynamic:/etc/traefik/dynamic:ro,Z
# Hardening (#458). The same block is in kendo-app, kendo-migrate and
# kendo-traefik: Quadlet has no include or anchor, so change all three.
# Read-only root, so a breach cannot write tools into the image. ACME state
# lives on its volume; /tmp is the only scratch space.
ReadOnly=true
Tmpfs=/tmp
# Every capability dropped but the one that binds 80/443 inside its own
# namespace; no setuid escalation.
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true
# Bounds a fork bomb or a leak to this container. Fixed defaults; tune them
# per host with a drop-in (docs/deployment.md, "Container limits").
PodmanArgs=--pids-limit=256 --memory=512m

[Service]
Restart=always

[Install]
WantedBy=default.target
