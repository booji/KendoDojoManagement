# Traefik edge proxy: terminates TLS, redirects 80->443, routes to kendo-app.
# The ONLY container that publishes host ports. Edge network only (never touches
# the db). Cloudflare DNS-01 token comes from a podman secret via _FILE.
#
# Binding 80/443 as a rootless user requires:
#   net.ipv4.ip_unprivileged_port_start=80   (see deploy/sysctl — Q9 option 1)
[Unit]
Description=Kendo Traefik
Requires=kendo-app.service
After=kendo-app.service

[Container]
ContainerName=kendo-traefik
Image=docker.io/library/traefik:v3.3
Network=kendo-edge.network
PublishPort=80:80
PublishPort=443:443
Volume=kendo-traefik-acme.volume:/acme
Volume=%h/kendo/traefik/traefik.yml:/etc/traefik/traefik.yml:ro,Z
Volume=%h/kendo/traefik/dynamic:/etc/traefik/dynamic:ro,Z
Environment=CF_DNS_API_TOKEN_FILE=/run/secrets/cf_dns_token
Secret=kendo_cf_dns_token,type=mount,target=cf_dns_token

[Service]
Restart=always

[Install]
WantedBy=default.target
