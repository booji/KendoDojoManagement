# FastAPI app (serves the built SPA + /api). No published host ports — reachable
# ONLY via Traefik on the edge network. Straddles both networks: edge (Traefik
# reaches it) and backend (it reaches the db).
#
# Secrets injected as env straight from podman secrets (no config.py change):
#   - DATABASE_URL (full URL, incl. password)
#   - JWT_SECRET
#   - SETUP_TOKEN (gates claiming the first admin account, ADR-0003)
# Non-sensitive config comes from the EnvironmentFile (see deploy/env/).
[Unit]
Description=Kendo App
Requires=kendo-db.service
After=kendo-db.service
# Schema first: kendo-migrate runs `alembic upgrade head` and exits (#391).
Requires=kendo-migrate.service
After=kendo-migrate.service

[Container]
ContainerName=kendo-app
Image=localhost/kendodojo:latest
Network=kendo-edge.network
Network=kendo-backend.network
EnvironmentFile=%h/kendo/kendo-app.env
# Persists uploaded logos/backgrounds (STATIC_DIR, STATIC_BACKGROUNDS_DIR in the
# EnvironmentFile point inside here). Without it they die with the container.
# `:U` chowns the volume to the container's non-root user on every start, so an
# upgrade from a root-running image does not leave the uploads directory
# unwritable (#385).
Volume=kendo-app-uploads.volume:/app/uploads:U
Secret=kendo_database_url,type=env,target=DATABASE_URL
Secret=kendo_jwt_secret,type=env,target=JWT_SECRET
Secret=kendo_setup_token,type=env,target=SETUP_TOKEN

[Service]
Restart=always

[Install]
WantedBy=default.target
