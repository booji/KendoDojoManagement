# `alembic upgrade head`, as its own oneshot unit rather than a step inside the
# app container (#391). kendo-app is ordered After= this, so it never serves
# against a half-migrated schema, and a failed migration fails visibly as
# kendo-migrate.service instead of as an app container that exited.
#
# Same image and env file as kendo-app; backend network only (it talks to the
# db and nothing else). Downtime during a long migration is unchanged — closing
# that window needs two app instances and an advisory lock in
# app/db/bootstrap.py, which single-dojo self-hosting does not warrant.
#
# The only unit given the superuser login (MIGRATION_DATABASE_URL). It migrates
# as that user, then creates or updates the app user named in DATABASE_URL —
# setting its password from the secret — and re-applies its grants, every run
# (ADR-0007). Rotating the app password is recreating kendo_database_url, then
# `systemctl --user restart kendo-migrate kendo-app` — restarting kendo-app
# alone does not re-run this unit, which stays active after it exits.
[Unit]
Description=Kendo schema migration
Requires=kendo-db.service
After=kendo-db.service

[Container]
ContainerName=kendo-migrate
# Published Release image pinned by its Release line (ADR-0004, ADR-0009):
# `:0.1` takes fixes and features but no Breaking change. Moving to `:0.2` is a
# deliberate edit here. `podman build -t localhost/kendodojo:latest .` still
# works — point this line at it to run your own build.
Image=ghcr.io/booji/kendodojomanagement:0.1
Network=kendo-backend.network
EnvironmentFile=%h/kendo/kendo-app.env
# Mounted as files, not environment, as in kendo-app.container (#462).
Secret=kendo_migration_database_url,type=mount,target=migration_database_url,uid=1001,gid=1001,mode=0400
Secret=kendo_database_url,type=mount,target=database_url,uid=1001,gid=1001,mode=0400
Environment=MIGRATION_DATABASE_URL_FILE=/run/secrets/migration_database_url
Environment=DATABASE_URL_FILE=/run/secrets/database_url
Entrypoint=python
Exec=-m app.db.bootstrap
# The image has no HEALTHCHECK and this container exits; without this Quadlet's
# default Type=notify would wait for a readiness notification that never comes.
Notify=no
# Hardening (#458). The same block is in kendo-app, kendo-migrate,
# kendo-ip-retention and kendo-traefik: Quadlet has no include or anchor, so
# change all four.
# Read-only root, so a breach cannot write tools into the image; /tmp is
# the only scratch space (Starlette spools uploads there).
ReadOnly=true
Tmpfs=/tmp
# No capabilities and no setuid escalation: it runs as an unprivileged user
# and needs none.
DropCapability=ALL
NoNewPrivileges=true
# Bounds a fork bomb or a leak to this container. Fixed defaults; tune them
# per host with a drop-in (docs/deployment.md, "Container limits").
PodmanArgs=--pids-limit=256 --memory=512m

[Service]
Type=oneshot
# Keeps the unit "active (exited)" after success, so kendo-app's Requires= is
# satisfied instead of being pulled back into a restart loop.
RemainAfterExit=yes
