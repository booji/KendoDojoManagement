{
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(pytest)",
      "Bash(cd * && . .venv/bin/activate && pytest *)",
      "Bash(. .venv/bin/activate && pytest *)",
      "Bash(podman-compose -f docker-compose.test.yml exec test *)",
      "Bash(docker compose -f docker-compose.test.yml exec test *)",
      "Bash(make test)",
      "Bash(make help)",
      "Bash(make logs)",
      "Bash(make down)",
      "Bash(. .venv/bin/activate && ruff check *)",
      "Bash(cd * && . .venv/bin/activate && ruff check *)",
      "Bash(npm run build *)",
      "Bash(npm run build)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pytest-on-edit.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pytest-on-edit.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/e2e-on-test-edit.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/e2e-on-test-edit.sh"
          }
        ]
      }
    ]
  }
}
